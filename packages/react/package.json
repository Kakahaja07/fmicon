{
  "name": "fmicon-react",
  "version": "1.4.0",
  "description": "1021 icons as React components.",
  "keywords": [
    "icons",
    "svg",
    "fmicon",
    "icon-library",
    "svg-icons",
    "ui-icons",
    "react",
    "react-icons"
  ],
  "license": "MIT",
  "homepage": "https://fmicon.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kakahaja07/fmicon.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Kakahaja07/fmicon/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=17"
  }
}
